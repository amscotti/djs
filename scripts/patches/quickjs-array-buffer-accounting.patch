+    return ctx->rt->array_buffer_bytes;
+}
+
 void JS_ComputeMemoryUsage(JSRuntime *rt, JSMemoryUsage *s)
 {
     struct list_head *el, *el1;
@@ -59142,6 +59148,7 @@ static JSValue js_array_buffer_constructor3(JSContext *ctx,
     if (!abuf)
         goto fail;
     abuf->byte_length = len;
