@@ -59615,6 +59627,7 @@ static JSValue js_array_buffer_transfer(JSContext *ctx, JSValueConst this_val,
             memset(bs + old_len, 0, new_len - old_len);
     }
     /* neuter the source */
+    ctx->rt->array_buffer_bytes -= abuf->byte_length;
     abuf->data = NULL;
     abuf->byte_length = 0;
     abuf->detached = true;
@@ -59672,6 +59685,7 @@ static JSValue js_array_buffer_resize(JSContext *ctx, JSValueConst this_val,
