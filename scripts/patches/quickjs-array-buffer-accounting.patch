             return JS_ThrowOutOfMemory(ctx);
         if (len > abuf->byte_length)
             memset(&data[abuf->byte_length], 0, len - abuf->byte_length);
+        ctx->rt->array_buffer_bytes += len - abuf->byte_length;
         abuf->byte_length = len;
         abuf->data = data;
     }
